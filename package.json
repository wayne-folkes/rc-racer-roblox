{
  "name": "rc-racer-roblox",
  "private": true,
  "version": "0.0.0",
  "description": "Spike: RC Racer's handling on Meadow Loop in Roblox, via roblox-ts and Rojo",
  "scripts": {
    "build": "rbxtsc",
    "watch": "rbxtsc -w",
    "place": "rbxtsc && rojo build -o spike.rbxlx",
    "serve": "rojo serve"
  },
  "devDependencies": {
    "@rbxts/compiler-types": "3.0.0-types.0",
    "@rbxts/types": "1.0.949",
    "roblox-ts": "3.0.0",
    "typescript": "5.5.3"
  }
}

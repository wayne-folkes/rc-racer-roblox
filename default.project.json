{
  "name": "rc-racer-spike",
  "globIgnorePaths": ["**/package.json", "**/tsconfig.json"],
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "rbxts_include": {
        "$path": "include",
        "node_modules": {
          "$className": "Folder",
          "@rbxts": {
            "$path": "node_modules/@rbxts"
          }
        }
      },
      "TS": {
        "$path": "out/shared"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "TS": {
          "$path": "out/client"
        }
      }
    },
    "Players": {
      "$className": "Players",
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "Voxel",
        "ClockTime": 14,
        "GlobalShadows": true,
        "Ambient": [0.45, 0.45, 0.5],
        "OutdoorAmbient": [0.6, 0.6, 0.65]
      }
    },
    "Workspace": {
      "$className": "Workspace"
    },
    "TextChatService": {
      "$className": "TextChatService",
      "$properties": {
        "ChatVersion": "TextChatService"
      }
    }
  }
}
